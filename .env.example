# EcoRoute AI — Root Environment Variables
# Single source of truth for frontend, gateway, and AI engine.
# Copy to .env and fill in values. NEVER commit .env.

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_BASE=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=
VITE_DEMO_MODE=false

# ── Gateway ──────────────────────────────────────────────────────────────────
GATEWAY_PORT=5000
MONGO_URI=mongodb://localhost:27017/ecoroute
JWT_SECRET=
PYTHON_AI_SERVICE_URL=http://localhost:8000
UNSPLASH_ACCESS_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_CLIENT_ID=
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
CLIENT_URL=http://localhost:5173

# ── AI Engine ────────────────────────────────────────────────────────────────
AI_PORT=8000
GEMINI_API_KEY=
OPENWEATHER_API_KEY=
MODEL=gemini-3.5-flash-lite

# ── Live real-time feeds ─────────────────────────────────────────────────────
# Crowd: BestTime private key is enough; empty URL uses POST https://besttime.app/api/v1/forecasts/live.
CROWD_API_URL=
CROWD_API_KEY=

# Transit: India GTFS-Realtime is used by default; no key needed.
TRANSIT_API_URL=
TRANSIT_API_KEY=
